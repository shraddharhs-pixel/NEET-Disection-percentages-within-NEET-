# Head has minor child (for Approach 3)
personal["is_child_of_head"] = (personal["q01_04"] == "SON/DAUGHTER") & (personal["q01_03"] < 18)
hh_head_child = (personal.groupby(["psu_number", "hh_number"])["is_child_of_head"].any().reset_index().rename(columns={"is_child_of_head": "head_has_minor_child"}))
working_age = pd.merge(working_age, hh_head_child, on=["psu_number", "hh_number"], how="left")

# Approach 1: Original
def approach1(row):
    if (row["neet_status"] and row["q01_05"] != "Never married" and row["q01_04"] in ["HEAD", "HUSBAND/WIFE"] and row.get("hh_children_count", 0) > 0):
        return True
    return False

# Approach 2: remove HEAD
def approach2(row):
    if (row["neet_status"] and row["q01_05"] != "Never married" and row["q01_04"] == "HUSBAND/WIFE" and row.get("hh_children_count", 0) > 0):
        return True
    return False

# Approach 3: remove HEAD AND the household head should have a son or daughter under 18
def approach3(row):
    if (row["neet_status"] and row["q01_05"] != "Never married" and row["q01_04"] == "HUSBAND/WIFE" and row.get("head_has_minor_child", False)):
        return True
    return False

# Apply all approaches
working_age["child_app1"] = working_age.apply(approach1, axis=1)
working_age["child_app2"] = working_age.apply(approach2, axis=1)
working_age["child_app3"] = working_age.apply(approach3, axis=1)

# Calculate percentages
neet_only = working_age[working_age["neet_status"]]
percentage1 = (neet_only.groupby("child_app1")["ind_wt"].sum() / neet_only["ind_wt"].sum() * 100).get(True, 0)
percentage2 = (neet_only.groupby("child_app2")["ind_wt"].sum() / neet_only["ind_wt"].sum() * 100).get(True, 0)
percentage3 = (neet_only.groupby("child_app3")["ind_wt"].sum() / neet_only["ind_wt"].sum() * 100).get(True, 0)

print("\nNEET individuals likely to have children:")
print(f"Approach 1 (Original): {percentage1:.1f}%")
print(f"Approach 2 (No HEAD): {percentage2:.1f}%")
print(f"Approach 3 (Nuclear Proxy): {percentage3:.1f}%")

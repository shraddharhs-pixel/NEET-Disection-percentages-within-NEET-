# households receiving remittances from abroad or not
def neet_remittance_from_abroad(row):
   if not row["neet_status"]:
       return None
   if row["q14_01"] != "YES":
       return "no_absentee"
   countrycode = row.get("q14_11")
   if pd.isna(countrycode):
       return "absentee_unknown"
   if not (800 <= countrycode < 820):  # outside Nepal remittance code range
       return "absentee_not_abroad"
   
   remittance = row.get("q14_15")
   if pd.isna(remittance):
       return "missing"
   if remittance in ["YES", 1]:
       return "remittance_from_abroad"
   return "no_remittance_from_abroad"

working_age["neet_remit_abroad"] = working_age.apply(neet_remittance_from_abroad, axis=1)
neet_only = working_age[working_age["neet_status"] == True]
percent = (neet_only.groupby("neet_remit_abroad")["ind_wt"].sum()/ neet_only["ind_wt"].sum() * 100)

print(f"NEET household receiving remittance from abroad: {percent.get('remittance_from_abroad',0):.1f}%")
print(f"NEET household abroad absentee but no remittance: {percent.get('no_remittance_from_abroad',0):.1f}%")
print(f"NEET household absentee not abroad: {percent.get('absentee_not_abroad',0):.1f}%")
print(f"NEET household with no absentee: {percent.get('no_absentee',0):.1f}%")
print(f"NEET household missing remittance info: {percent.get('missing',0):.1f}%")

# REMITTANCE QUINTILES
remit_df = working_age[["psu_number","hh_number","q14_21","hhs_wt"]].drop_duplicates()
remit_df = remit_df[remit_df["q14_21"] > 0].copy()
remit_df = remit_df.rename(columns={"q14_21": "remit_total"})

remit_df = remit_df.sort_values("remit_total")
remit_df["cum_wt"] = remit_df["hhs_wt"].cumsum() / remit_df["hhs_wt"].sum()
remit_df["remit_quintile"] = pd.cut(remit_df["cum_wt"], bins=[0,0.2,0.4,0.6,0.8,1], labels=[1,2,3,4,5])

# Merge back to individuals
working_age = pd.merge(working_age, remit_df[["psu_number","hh_number","remit_quintile"]], on=["psu_number","hh_number"], how="left")

# NEET distribution among remittance-receiving households
neet_remit = working_age[(working_age["neet_status"]) & (working_age["remit_quintile"].notna())]

remittance_share = (neet_remit.groupby("remit_quintile")["ind_wt"].sum() / neet_remit["ind_wt"].sum()* 100)

print("\nNEET distribution across remittance quintiles:")
print(remittance_share.sort_index())

# FAMILY CONSUMPTION
working_age["pcep_quintile"] = working_age["quintile_pcep"]
neet_only = working_age[working_age["neet_status"]]
neet_quintile_share = (neet_only.groupby("pcep_quintile")["ind_wt"].sum()/ neet_only["ind_wt"].sum()* 100)
print(neet_quintile_share.sort_index())

# Classify NEETs above or below mean consumption
meanpcep = ((working_age["pcep"] * working_age["ind_wt"]).sum()/ working_age["ind_wt"].sum())
def neetpcep_mean(row):
   if not row["neet_status"]:
       return None
   if row["pcep"] > meanpcep:
       return "above mean"
   return "below mean"

working_age["neet_pcep_mean"] = working_age.apply(neetpcep_mean, axis=1)
neet_only = working_age[working_age["neet_status"] == True]
pceppercentages = (neet_only.groupby("neet_pcep_mean")["ind_wt"].sum()/ neet_only["ind_wt"].sum() * 100)
print("\nNEET above/below mean consumption (%):")
print(f"NEET above mean: {pceppercentages.get('above mean', 0):.1f}%")
print(f"NEET below mean: {pceppercentages.get('below mean', 0):.1f}%")

# ASSETS
# Calculate total household and other assets
dwelling = pd.to_numeric(working_age["q02_12"], errors="coerce").fillna(0)
if "q11_31a" in working_age.columns:
   land = pd.to_numeric(working_age["q11_31a"], errors="coerce").fillna(0)
elif "q11_31" in working_age.columns:
   land = pd.to_numeric(working_age["q11_31"], errors="coerce").fillna(0)
elif "q11_13" in working_age.columns:
   land = pd.to_numeric(working_age["q11_13"], errors="coerce").fillna(0)
else:
   land = 0
property_asset = pd.to_numeric(working_age["q13_29"], errors="coerce").where(working_age["q13_28"].isin(["YES", 1]),0).fillna(0)
other_assets = pd.to_numeric(working_age["q13_35"], errors="coerce").where(working_age["q13_34"].isin(["YES", 1]),0).fillna(0)

# Sum all assets to get total_assets
working_age["total_assets"] = dwelling + land + property_asset + other_assets

# Keep only households with positive assets
assets_positive = working_age[working_age["total_assets"] > 0].copy()

# Sort by total_assets, compute cumulative weighted share, and assign quintiles
assets_positive = assets_positive.sort_values("total_assets")
assets_positive["wt"] = assets_positive["ind_wt"].sum()
assets_positive["share"] = assets_positive["wt"] / assets_positive["ind_wt"].sum()

# ASSET QUINTILES (household level)
# Create household-level dataset
asset_df = working_age[[
    "psu_number","hh_number","total_assets","hhs_wt"
]].drop_duplicates()

# Keep households with assets
asset_df = asset_df[asset_df["total_assets"] > 0].copy()

# Sort by assets
asset_df = asset_df.sort_values("total_assets")

# Weighted cumulative share
asset_df["cum_wt"] = asset_df["hhs_wt"].cumsum() / asset_df["hhs_wt"].sum()

# Assign quintiles
asset_df["asset_quintile"] = pd.cut(asset_df["cum_wt"], bins=[0,0.2,0.4,0.6,0.8,1], labels=[1,2,3,4,5])

# Merge back to working_age
working_age = pd.merge(working_age, asset_df[["psu_number","hh_number","asset_quintile"]], on=["psu_number","hh_number"], how="left")
neet_only = working_age[working_age["neet_status"]]

asset_share = (neet_only.groupby("asset_quintile")["ind_wt"].sum() / neet_only["ind_wt"].sum() * 100)
print(asset_share.sort_index())

# EDUCATION
# NEET distribution by current or past school attendance
neet_only = working_age[working_age["neet_status"] == True]
neet_edu_percent = (neet_only.groupby("q07_04")["ind_wt"].sum() / neet_only["ind_wt"].sum() * 100)

print("\nNEET percentages by school attendance:")
print(f"Never attended school: {neet_edu_percent.get(1, 0):.1f}%")
